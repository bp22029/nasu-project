# 環境変数の雛形。これをコピーして .env.local を作り、実際の値を入れる。
#   cp .env.example .env.local
# .env.local は Git 管理外（.gitignore）。値はコミットしないこと。
# Vercel では同じ変数を Project Settings → Environment Variables に登録する。

# --- サーバー専用（ブラウザに露出しない。NEXT_PUBLIC_ を付けない）---

# Google Places API (New) を有効化したキー。
# 制限: サーバー（API Route / Vercel関数）から呼ぶため「アプリケーションの制限=なし」。
#       Vercelはサーバー関数のIPが動的なので「IPアドレス制限」は使えない。
#       代わりに「APIの制限」で Places API (New) のみに絞り、予算アラートを設定する。
GOOGLE_PLACES_API_KEY=

# openrouteservice.org で発行した新形式トークン（長い16進数の文字列）。
# 旧 eyJ... 形式は不可。
ORS_API_KEY=

# 管理者ページ（/admin/*）の Basic 認証。src/middleware.ts が参照する。
# ADMIN_PASSWORD 未設定なら開発は素通し・本番は 503（未設定のまま公開されない）。
# 本番（Vercel）では必ず ADMIN_PASSWORD を設定する。ADMIN_USER 省略時は "admin"。
ADMIN_USER=admin
ADMIN_PASSWORD=

# --- 公開（NEXT_PUBLIC_。ブラウザから supabase-js で直アクセスするため必須）---
# 公開前提のキー。防壁は RLS。service_role キーは絶対に置かない。

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# スポットデータの切替: debug=13件（開発・既定） / full=約200件（本番）。
# Vercel の本番環境では full を設定する。
NEXT_PUBLIC_SPOTS_MODE=debug

# （任意）開発中に Google 写真APIを一切呼ばない。true で写真取得をスキップ。
# NEXT_PUBLIC_DEBUG_NO_PHOTOS=false
